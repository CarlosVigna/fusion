+  };
+  const { label, cls } = map[status] || { label: status || "—", cls: "bg-zinc-700/40 text-zinc-400" };
+  return (
+    <span className={`rounded-full px-3 py-1 text-xs font-semibold ${cls}`}>{label}</span>
